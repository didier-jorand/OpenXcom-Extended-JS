// StoreRefill.json
// Specification of the automated store management for
// the script 'JSAutoStore1'
//
// Note: basic syntax check with:
// qjs --std  -e "std.parseExtJSON(std.loadFile('StoreRefill.json'))"
//

{
	version: "0.1",
	description: "refill items as needed (manufacture or buy automatically)",

	fallback_production: [
		{item: "STR_ALIEN_LASER_RIFLE", onlyifresearched: "STR_ALIEN_LASER_RIFLE"},
		{item: "STR_HEALING_SPRAY", onlyifresearched: "STR_HEALING_SPRAY"},
		{item: "STR_MOTION_SCANNER", onlyifresearched: "STR_MOTION_SCANNER"},
		{item: "STR_MEDI_KIT", onlyifresearched: "STR_MEDI_KIT"},
		],


	// 'bases' entry is a map of bases,
	// - 'default' is the default configuration; if there is an entry by
	// number (1 to 8) or by base name, it has the priority over
	// the default.
	bases: {
		"default": {
			// Each item to manage automatically has an entry with
			// its ID in the map and the value is an object with
			// attributes
			// - min: below this quantity, refill by purchase or manufacture
			// - max: target quantity after refill
			// or
			// - relto: ID of an item which total number is the coefficient to
			// calculate effecitve min and max (*)
			// - rmin: idem min but relative to the number of item "relto"; if not an integer,
			// round to the value below
			// - rmax: idem max but relative to the number of item "relto"; if not an integer,
			// round to the value above
			// - onlyifstore: apply only if there is this other object in the base store
			// - onlyifweapon: apply only if this other object is used as a
			// weapon in a craft (for craft weapons ammo, like avalanche missiles, etc...)
			// - onlyifcraft: apply only if this other object is stored in a craft
			// as item (not as weapon)
			// - onlyifnot: do not apply if this other object is available (to manage
			// obsolete/replaced items), meaning researched or in purchase list
			// - onlyifresearched: apply only this research has been completed
			//
			// (*) Example: we have 10 rifles and for rifle clips, we have: rmin=1.2 and rmax=1.6
			// then, when there are less than 12 clips, we refill up to 16 clips.

			// ***** Craft Weapons Ammo *****
			// Each avalanche launcher carries 3 missiles ; the minimum is to be able to refill
			// after a mission, therefore to have 6 missiles (3 in the weapon and 3 in store)
			// But we can also mutualize and assume that not all missiles from all weapons will
			// be fired in the same timeframe and set rmin/rmax to lower values (see stingray)
			STR_AVALANCHE_MISSILES: {rmin: 6, rmax: 9, onlyifweapon: "STR_AVALANCHE_LAUNCHER", relto: "STR_AVALANCHE_LAUNCHER"},
			STR_STINGRAY_MISSILES: {rmin: 8, rmax: 12, onlyifweapon: "STR_STINGRAY_LAUNCHER", relto: "STR_STINGRAY_LAUNCHER"},
			STR_CANNON_ROUNDS_X50: {rmin: 4, rmax: 5, onlyifweapon: "STR_CANNON", relto: "STR_CANNON"},

			STR_ALLOY_CANNON_ROUNDS_X50: {rmin: 6, rmax: 8, onlyifweapon: "STR_ALLOY_CANNON", relto: "STR_ALLOY_CANNON", onlyifresearched: "STR_ALLOY_CANNON" },

			STR_GAUSS_CANNON_ROUNDS_X60: {rmin: 3, rmax: 5, onlyifweapon: "STR_GAUSS_CANNON", relto: "STR_GAUSS_CANNON", onlyifresearched: "STR_GAUSS_CANNON" },

			// ***** Components *****
			STR_ALIEN_ALLOYS: {min: 30, max: 50, onlyifresearched: "STR_ALIEN_ALLOYS"},

			// ***** Equipment *****
			STR_MEDI_PACK: {min: 2, max: 6, onlyifnot: "STR_MEDI_KIT"},
			STR_HEALING_SPRAY: {min: 8, max: 12, onlyifnot: "STR_MEDI_KIT", onlyifresearched: "STR_HEALING_SPRAY"},
			STR_MEDI_KIT: {min: 2, max: 6, onlyifresearched: "STR_MEDI_KIT"},
			STR_FIRE_EXTINGUISHER: {min: 2, max: 2},

			STR_ARMORED_VEST: {min: 2, max: 4, onlyifnot: "STR_ALLOY_VEST"},
			STR_ALLOY_VEST: {min: 2, max: 4, onlyifnot: "STR_PERSONAL_ARMOR", onlyifresearched: "STR_ALLOY_VEST"},
			STR_PERSONAL_ARMOR: {min: 2, max: 4, onlyifnot: "STR_POWER_SUIT", onlyifresearched: "STR_PERSONAL_ARMOR"},
			STR_JUMP_ARMOR: {min: 2, max: 4, onlyifnot: "STR_FLYING_SUIT", onlyifresearched: "STR_JUMP_ARMOR"},
			STR_POWER_SUIT: {min: 2, max: 4, onlyifresearched: "STR_POWER_SUIT"},
			STR_FLYING_SUIT: {min: 2, max: 4, onlyifresearched: "STR_FLYING_SUIT"},
			STR_TOXY_SUIT: {min: 0, max: 0, onlyifresearched: "STR_TOXY_SUIT"},

			// ***** Other weapons and equipments *****
			STR_GRENADE: {min: 8, max: 12, onlyifnot: "STR_ALIEN_GRENADE"},
			STR_HIGH_EXPLOSIVE: {min: 8, max: 12},
			STR_ELECTRO_FLARE: {min: 12, max: 24},
			STR_STUN_ROD: {min: 4, max: 8, onlyifnot: "STR_STUN_BOMB"},


			// ***** Rifles and rifles ammo *****
			// we use rifles as long as we cannot use alien laser rifles, which
			// requires not only the weapon but also its clip
			STR_RIFLE: {min: 8, max: 12, onlyifnot: "STR_ALIEN_LASER_RIFLE"},
			STR_RIFLE_CLIP: {min: 4, max: 8, onlyifcraft: "STR_RIFLE", onlyifnot: "STR_RIFLE_AA_CLIP"},
			STR_RIFLE_AA_CLIP: {min: 4, max: 8, onlyifcraft: "STR_RIFLE", onlyifresearched: "STR_RIFLE_AA_CLIP"},

			//   ensure to have enough sniper rifle clip or (when researched) alloy clip, then heavy
			STR_SNIPER_RIFLE: {min: 2, max: 2, onlyifnot: "STR_HEAVY_SNIPER_RIFLE"},
			STR_SNIPER_RIFLE_CLIP: {min: 2, max: 4, onlyifcraft: "STR_SNIPER_RIFLE", onlyifnot: "STR_SNIPER_RIFLE_AA_CLIP"},
			STR_SNIPER_RIFLE_AA_CLIP: {min: 2, max: 4, onlyifcraft: "STR_SNIPER_RIFLE", onlyifresearched: "STR_SNIPER_RIFLE_AA_CLIP"},

			//   advanced firearms: replace sniper rifles by heavy sniper rifle (tactical sniper rifle)
			STR_HEAVY_SNIPER_RIFLE: {min: 2, max: 2, onlyifresearched: "STR_HEAVY_SNIPER_RIFLE"},
			STR_HEAVY_SNIPER_RIFLE_CLIP: {min: 4, max: 6, onlyifnot: "STR_HEAVY_SNIPER_RIFLE_AA_CLIP", onlyifcraft: "STR_HEAVY_SNIPER_RIFLE", onlyifresearched: "STR_HEAVY_SNIPER_RIFLE"},
			STR_HEAVY_SNIPER_RIFLE_AA_CLIP: {rmin: 2, rmax: 4, onlyifcraft: "STR_HEAVY_SNIPER_RIFLE", relto: "STR_HEAVY_SNIPER_RIFLE", onlyifresearched: "STR_HEAVY_SNIPER_RIFLE_AA_CLIP"},
			STR_HEAVY_SNIPER_RIFLE_HE_CLIP: {rmin: 2, rmax: 3, onlyifcraft: "STR_HEAVY_SNIPER_RIFLE", relto: "STR_HEAVY_SNIPER_RIFLE", onlyifresearched: "STR_HEAVY_SNIPER_RIFLE_HE_CLIP"},

			// ***** Guns *****
			STR_SMG_CLIP: {min: 2, max: 4, onlyifcraft: "STR_SMG", onlyifnot: "STR_SMG_AA_CLIP"},
			STR_SMG_AA_CLIP: {min: 4, max: 8, onlyifcraft: "STR_SMG", onlyifresearched: "STR_SMG_AA_CLIP"},

			STR_LIGHT_MINIGUN: {min: 2, max: 2},
			STR_LIGHT_MINIGUN_CLIP: {min: 4, max: 8, onlyifcraft: "STR_LIGHT_MINIGUN", onlyifnot: "STR_LIGHT_MINIGUN_AA_CLIP"},
			STR_LIGHT_MINIGUN_AA_CLIP: {min: 4, max: 8, onlyifcraft: "STR_LIGHT_MINIGUN", onlyifresearched: "STR_LIGHT_MINIGUN_AA_CLIP"},

			STR_SHOTGUN: {min: 2, max: 2},
			STR_SHOTGUN_SHELLS: {min: 4, max: 8, onlyifcraft: "STR_SHOTGUN", onlyifnot: "STR_SHOTGUN_AA_SHELLS"},
			STR_SHOTGUN_SHELLS_AP: {min: 4, max: 8, onlyifcraft: "STR_SHOTGUN", onlyifnot: "STR_SHOTGUN_AA_SHELLS_AP"},
			STR_SHOTGUN_AA_SHELLS: {min: 4, max: 8, onlyifcraft: "STR_SHOTGUN", onlyifresearched: "STR_SHOTGUN_AA_SHELLS"},
			STR_SHOTGUN_AA_SHELLS_AP: {min: 4, max: 8, onlyifcraft: "STR_SHOTGUN", onlyifresearched: "STR_SHOTGUN_AA_SHELLS_AP"},

			// ***** Laser, Nuclear Laser, Gauss and Plasma (Pistol, Rifle, Heavy and Sniper + shotgun,scatter for laser) *****
			STR_GAUSS_PISTOL_CLIP: {rmin: 1, rmax: 3, onlyifweapon: "STR_GAUSS_PISTOL", relto: "STR_GAUSS_PISTOL", onlyifresearched: "STR_GAUSS_PISTOL" },
			STR_GAUSS_RIFLE_CLIP: {rmin: 1, rmax: 3, onlyifweapon: "STR_GAUSS_RIFLE", relto: "STR_GAUSS_RIFLE", onlyifresearched: "STR_GAUSS_RIFLE" },
			STR_GAUSS_SNIPER_RIFLE_CLIP: {rmin: 1, rmax: 3, onlyifweapon: "STR_GAUSS_SNIPER_RIFLE", relto: "STR_GAUSS_SNIPER_RIFLE", onlyifresearched: "STR_GAUSS_SNIPER_RIFLE_CLIP" },
			STR_HEAVY_GAUSS_CLIP: {rmin: 1, rmax: 3, onlyifweapon: "STR_HEAVY_GAUSS", relto: "STR_HEAVY_GAUSS", onlyifresearched: "STR_HEAVY_GAUSS_CLIP" },

			STR_LASER_RIFLE_MIB_CLIP: {rmin: 1, rmax: 3, onlyifweapon: "STR_LASER_RIFLE_MIB", relto: "STR_LASER_RIFLE_MIB", onlyifresearched: "STR_LASER_RIFLE_MIB" },

			// ***** tests *****
			//ERRONEOUS: {min: 1, max: 10, onlyifnot: "STR_PISTOL"},
			//STR_PISTOL: {min: 1, max: 10, onlyifnot: "ERRONEOUS"},

		},

		"Jakarta": {
			// ***** Components *****
			STR_ALIEN_ALLOYS: {min: 30, max: 50, onlyifresearched: "STR_ALIEN_ALLOYS"},
			// ***** Craft Weapons Ammo *****
			STR_AVALANCHE_MISSILES: {rmin: 6, rmax: 9, onlyifweapon: "STR_AVALANCHE_LAUNCHER", relto: "STR_AVALANCHE_LAUNCHER"},
			STR_ALLOY_CANNON_ROUNDS_X50: {rmin: 6, rmax: 8, onlyifweapon: "STR_ALLOY_CANNON", relto: "STR_ALLOY_CANNON", onlyifresearched: "STR_ALLOY_CANNON" },
			STR_GAUSS_CANNON_ROUNDS_X60: {rmin: 3, rmax: 5, onlyifweapon: "STR_GAUSS_CANNON", relto: "STR_GAUSS_CANNON", onlyifresearched: "STR_GAUSS_CANNON" },
			},

		"BUENOS AIRES": {
			// ***** Components *****
			STR_ALIEN_ALLOYS: {min: 30, max: 50, onlyifresearched: "STR_ALIEN_ALLOYS"},
			// ***** Craft Weapons Ammo *****
			STR_AVALANCHE_MISSILES: {rmin: 6, rmax: 9, onlyifweapon: "STR_AVALANCHE_LAUNCHER", relto: "STR_AVALANCHE_LAUNCHER"},
			STR_ALLOY_CANNON_ROUNDS_X50: {rmin: 6, rmax: 8, onlyifweapon: "STR_ALLOY_CANNON", relto: "STR_ALLOY_CANNON", onlyifresearched: "STR_ALLOY_CANNON" },
			STR_GAUSS_CANNON_ROUNDS_X60: {rmin: 3, rmax: 5, onlyifweapon: "STR_GAUSS_CANNON", relto: "STR_GAUSS_CANNON", onlyifresearched: "STR_GAUSS_CANNON" },
			},

		"LE CAP": {},

	}
}
